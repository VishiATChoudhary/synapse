{
  "appId": "dev.synapse.desktop",
  "productName": "Synapse",
  "electronVersion": "44.7.2",
  "directories": {
    "app": ".",
    "output": "dist",
    "buildResources": "app/build"
  },
  "asar": false,
  "npmRebuild": false,
  "files": [
    "lib.mjs",
    "ops.mjs",
    "remote.mjs",
    "talk.mjs",
    "account.mjs",
    "hook.mjs",
    "mcp.mjs",
    "cli.mjs",
    "install.mjs",
    "demo.mjs",
    "server.mjs",
    "discovery.mjs",
    "tokens.css",
    "skill/**",
    "public/**",
    "app/main.mjs",
    "app/preload.cjs",
    "app/worktrees.mjs",
    "app/updater.mjs",
    "app/phone.mjs",
    "app/phone-share.mjs",
    "app/phone-media.mjs",
    "app/activity.mjs",
    "app/renderer/**",
    "app/node_modules/**",
    "!app/node_modules/electron/**",
    "!app/node_modules/@napi-rs/**",
    "!app/node_modules/pdfjs-dist/{legacy,types,image_decoders}/**",
    "!app/node_modules/pdfjs-dist/**/*.map",
    "!app/node_modules/pdf-lib/{cjs,es,src}/**",
    "!app/node_modules/pdf-lib/dist/{pdf-lib.js,pdf-lib.min.js,pdf-lib.esm.js,*.map}",
    "!app/node_modules/@electron/**",
    "!app/node_modules/@electron-internal/**",
    "!app/node_modules/node-gyp/**",
    "!app/node_modules/.bin/**",
    "!**/*.map",
    "!**/README.md",
    "!**/CHANGELOG.md"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "app/build/icon.png",
    "target": [
      "dmg",
      "dir"
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "app/build/entitlements.mac.plist",
    "entitlementsInherit": "app/build/entitlements.mac.inherit.plist",
    "notarize": true,
    "extraResources": [
      {
        "from": "app/vendor/cloudflared",
        "to": "cloudflared"
      }
    ]
  },
  "dmg": {
    "title": "Synapse",
    "contents": [
      {
        "x": 150,
        "y": 190
      },
      {
        "x": 390,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "app/build/icon.png",
    "extraResources": [
      {
        "from": "app/vendor/cloudflared.exe",
        "to": "cloudflared.exe"
      }
    ],
    "signExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "Synapse-Setup-${version}.exe",
    "shortcutName": "Synapse",
    "deleteAppDataOnUninstall": false
  },
  "electronLanguages": [
    "en-US"
  ],
  "afterPack": "scripts/verify-app.cjs"
}
